<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer, built on Linux by wixl. There is no Windows runner in
  this pipeline and this file does not need one: wixl reads this source and
  writes the .msi, and the same cross-build that produces meshbench.exe
  produces the installer around it.

  What this exists for is the layout rather than the binary. The bundle carries
  QEMU, Renode and the SX1262 model, and finds them beside meshbench.exe, so a
  user who unpacks the zip and then moves the one executable somewhere tidy has
  silently broken emulation with nothing to tell them so. An installer puts the
  whole directory somewhere deliberate and keeps it together.

  Built by wixl rather than the WiX toolset, deliberately. WiX was tried for
  the sake of the install-folder dialogs, which wixl cannot build - see
  GNOME/msitools#3 - and it cannot be used here at all: it needs Windows'
  msi.dll to write the database, so on Linux it gets as far as refusing every
  Directory/@Name as "not a relative path" and would fail on msi.dll even if
  that were fixed. Its own first line of output says it only supports Windows.
  Building the installer on a Windows runner is what the dialogs would cost,
  and that is a change to the shape of the pipeline rather than to this file.

  Everything under the install directory is harvested by wixl-heat into
  ComponentGroup "Bundle", so this file carries only what a harvest cannot
  know: where it goes, what it is called, how it upgrades, and the shortcuts.

  Three variables come from packaging/windows-msi.sh:
    ProductCode  the GUID for this exact version, derived from it
    Version      X.Y.Z, which is what Apps and Features shows
    Extra        the two files that come from this repository rather than from
                 the staged bundle: the icon and the note below
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.ProductCode)"
           Name="MeshBench"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="MeshBench"
           UpgradeCode="6f2a1c84-7f3b-4c9e-9a6d-0d8f5b1e2c30">

    <!--
      InstallerVersion 500 is Windows Installer 5.0, which is Windows 7 and
      later, and it is what makes one package able to install per-machine or
      per-user. Below that, ALLUSERS=2 is not honoured and the package would
      have to pick one for everybody.
    -->
    <Package InstallerVersion="500"
             Compressed="yes"
             Manufacturer="MeshBench"
             Description="MeshBench $(var.Version)"
             Comments="Plan and test MeshCore LoRa networks against real firmware. GPL-3.0-or-later."/>

    <Media Id="1" Cabinet="meshbench.cab" EmbedCab="yes"/>

    <!--
      Upgrade in place, which is the thing an installer gets wrong by
      installing a second copy beside the first.

      Three pieces have to agree for that not to happen. UpgradeCode above is
      fixed for the life of the product and identifies "MeshBench" across every
      version. ProductCode is derived from the version by the build script, so
      two builds of the same version are the same product and a reinstall is a
      reinstall rather than a second arrival. And the range below claims every
      version below this one, so installing 0.3.0 over 0.2.0 finds it, removes
      it, and installs into the same place.

      The second range only detects: a downgrade is refused by the condition
      further down rather than allowed to write older files over newer ones.
    -->
    <Upgrade Id="6f2a1c84-7f3b-4c9e-9a6d-0d8f5b1e2c30">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes"
                      Maximum="$(var.Version)" IncludeMaximum="no"
                      Property="OLDERVERSIONBEINGUPGRADED"/>
      <UpgradeVersion Minimum="$(var.Version)" IncludeMinimum="yes"
                      OnlyDetect="yes"
                      Property="NEWERVERSIONDETECTED"/>
    </Upgrade>

    <!--
      After InstallValidate, so the old version is gone before the new files
      are written. Scheduled late instead, the two copies coexist for part of
      the transaction and the old one's uninstall takes the new one's files
      with it where a name is shared - which is most of this bundle.
    -->
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallValidate"/>
    </InstallExecuteSequence>

    <Condition Message="A newer MeshBench is already installed. Remove it first if you meant to go back to this one.">
      NOT NEWERVERSIONDETECTED OR Installed
    </Condition>

    <!--
      2 rather than 1: the package decides per install rather than for
      everybody. Left alone it installs per-machine into Program Files and asks
      for elevation; with MSIINSTALLPERUSER=1 it installs under the user's own
      profile and asks for nothing.
    -->
    <Property Id="ALLUSERS" Value="2"/>

    <!--
      SecureCustomProperties is not authored here even though INSTALLDIR needs
      to be in it - a property set on the msiexec command line is dropped when
      the install elevates unless it is named there, so a chosen location would
      otherwise work for a per-user install and be ignored for a per-machine
      one, which is the worse half of not working. wixl writes that row itself
      to carry the two upgrade properties below, and a second row with the same
      key fails the build. packaging/windows-msi.sh appends to the row wixl
      wrote, and packaging/verify-msi.sh checks the result.
    -->
    <Property Id="ARPPRODUCTICON" Value="meshbench.ico"/>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MeshBench/meshbench"/>
    <!--
      No Modify button. wixl builds no dialogs, so the button would open an
      installer with nothing in it to change; the desktop shortcut is chosen on
      the command line at install time instead, as below.
    -->
    <Property Id="ARPNOMODIFY" Value="1"/>

    <Icon Id="meshbench.ico" SourceFile="$(var.Extra)/meshbench.ico"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="MeshBench"/>
      </Directory>
      <Directory Id="ProgramMenuFolder"/>
      <Directory Id="DesktopFolder"/>
    </Directory>

    <!--
      The one file the zip does not carry, and the only difference between the
      two Windows bundles once they are unpacked. It answers the question a
      person asks when they find this directory - how did this get here and how
      do I remove it - and the application reads it for the same reason: an
      installed build is updated by running the newer installer, and a build
      unpacked from a zip is not, so the two cannot be told the same thing.
    -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="InstallNote" Guid="3d6b8f47-1e29-4a05-b8c3-92f7d4e6a018" Win64="yes">
        <File Id="installed_by_msi.txt" Name="installed-by-msi.txt"
              Source="$(var.Extra)/installed-by-msi.txt" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!--
      A shortcut cannot be a component's own key path, so a registry value
      stands in for one. HKCU rather than HKMU, which would be the better
      answer and follow the install into whichever hive it went to: wixl writes
      its own enumeration into the Registry table's Root column rather than the
      value Windows Installer defines, and HKMU comes out as 4, which is not a
      root at all. HKCU comes out as 1, which is.
    -->
    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="b41d6e02-3a55-4f18-9c27-7e4a0b6d9155" Win64="yes">
        <Shortcut Id="StartMenuMeshBench"
                  Name="MeshBench"
                  Description="Plan and test MeshCore LoRa networks against real firmware"
                  Target="[INSTALLDIR]meshbench.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="meshbench.ico"/>
        <RegistryValue Root="HKCU" Key="Software\MeshBench\MeshBench"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!--
      Off unless asked for. An installer that plants a desktop icon nobody
      asked for is the behaviour people complain about, so this is a feature at
      level 0 - present in the package, not installed unless the install names
      it. It is a feature rather than a component with a condition on it
      because wixl does not build conditions on components, and this way the
      switch is one Windows Installer already understands:

        msiexec /i meshbench-<version>-windows-x86_64.msi ADDLOCAL=Complete,DesktopShortcut
    -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="0a7c3d91-58e6-42b7-8d10-c3f9a2e47b68" Win64="yes">
        <Shortcut Id="DesktopMeshBench"
                  Name="MeshBench"
                  Description="Plan and test MeshCore LoRa networks against real firmware"
                  Target="[INSTALLDIR]meshbench.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="meshbench.ico"/>
        <RegistryValue Root="HKCU" Key="Software\MeshBench\MeshBench"
                       Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="MeshBench" Level="1" Display="expand"
             Description="MeshBench, the emulators, the radio model and the shipped fixtures">
      <ComponentGroupRef Id="Bundle"/>
      <ComponentRef Id="InstallNote"/>
      <ComponentRef Id="StartMenuShortcut"/>

      <Feature Id="DesktopShortcut" Title="Desktop shortcut" Level="0"
               Description="A MeshBench icon on the desktop as well as in the Start menu">
        <ComponentRef Id="DesktopShortcutComponent"/>
      </Feature>
    </Feature>
  </Product>
</Wix>
